+import { T } from "./strings.ts";
+
+export default function AuditViewer() {
+  const guarded = useTopGuard();
+  const [f, setF] = useState<AuditFilters>(emptyAuditFilters);
+  const [rows, setRows] = useState<AuditRow[] | null>(null);
+  const [next, setNext] = useState<number | undefined>();
+  const [error, setError] = useState<string | null>(null);
+  const [verify, setVerify] = useState<{ tone: "ok" | "error"; text: string } | null>(null);
+  const load = useGuard(); const ver = useGuard();
+  const applied = useRef<AuditFilters>(f);
+
+  async function search(cursor?: number) {
+    const filters = cursor === undefined ? f : applied.current;
+    const q = auditQuery(filters, cursor);
+    if (!q) { setError(T.audit.badRange); return; }
+    setError(null);
+    await load.run(async () => {
+      try {
+        const out = await guarded(() => lmmx.top.auditList(q));
+        if (cursor === undefined) applied.current = f;
+        setRows((cur) => (cursor === undefined || !cur ? out.rows : mergeRows(cur, out.rows, (r) => String(r.seq)))); setNext(out.nextCursor);
+      } catch (e) { setError(errorText(e)); }
+    });
+  }
+  async function doVerify() {
+    setVerify(null);
+    await ver.run(async () => {
+      try { setVerify(verifyMessage(await guarded(() => lmmx.top.auditVerify({})))); } catch (e) { setVerify({ tone: "error", text: errorText(e) }); }
+    });
+  }
+  const set = (p: Partial<AuditFilters>) => setF({ ...f, ...p });
+  return (
+    <div className="min-w-0 space-y-4">
+      <Card title={T.audit.title}>
+        <div className="grid min-w-0 gap-3 sm:grid-cols-2">
+          <FormField label={T.audit.tenant} htmlFor="au-t"><input id="au-t" autoComplete="off" value={f.tenantId} onChange={(e) => set({ tenantId: e.target.value.slice(0, 60) })} className={inputClass} /></FormField>
+          <FormField label={T.audit.desk} htmlFor="au-d"><input id="au-d" autoComplete="off" value={f.deskCode} onChange={(e) => set({ deskCode: e.target.value.toUpperCase().slice(0, 8) })} className={inputClass} /></FormField>
+          <FormField label={T.audit.action} htmlFor="au-a"><select id="au-a" value={f.action} onChange={(e) => set({ action: e.target.value as AuditFilters["action"] })} className={inputClass}><option value="">{T.audit.anyAction}</option>{AUDIT_ACTIONS.map((a) => <option key={a} value={a}>{AUDIT_ACTION_LABELS[a]}</option>)}</select></FormField>
+          <div className="grid min-w-0 grid-cols-2 gap-3">
+            <FormField label={T.audit.from} htmlFor="au-f"><input id="au-f" type="date" value={f.from} onChange={(e) => set({ from: e.target.value })} className={inputClass} /></FormField>
+            <FormField label={T.audit.to} htmlFor="au-to"><input id="au-to" type="date" value={f.to} onChange={(e) => set({ to: e.target.value })} className={inputClass} /></FormField>
+          </div>
+        </div>
+        <div className="mt-4 flex flex-wrap gap-2">
+          <button type="button" disabled={load.busy} onClick={() => void search()} className={buttonClass.primary}>{load.busy ? T.reason.working : T.audit.apply}</button>
+          <button type="button" disabled={ver.busy} onClick={() => void doVerify()} className={buttonClass.secondary}>{ver.busy ? T.audit.verifying : T.audit.verify}</button>
+        </div>
+      </Card>
+      {verify && <Notice tone={verify.tone}><strong>{verify.text}</strong></Notice>}
+      {error && <Notice tone="error">{error}</Notice>}
+      {rows && (
+        <Card>
+          <DataTable<AuditRow> rows={rows} rowKey={(r) => String(r.seq)} empty={<EmptyState title={T.audit.empty} />}
+            columns={[
+              { key: "s", header: T.audit.seq, primary: true, cell: (r) => `#${r.seq} · ${fmtWhen(r.ts)}` },
+              { key: "a", header: T.audit.what, cell: (r) => <Badge tone="blue">{AUDIT_ACTION_LABELS[r.action] ?? r.action}</Badge> },
+              { key: "w", header: T.audit.who, cell: (r) => `${r.actor.type}${r.actor.deskCode ? ` ${r.actor.deskCode}` : ""}` },
+              { key: "t", header: T.audit.tenant, cell: (r) => r.tenantId ?? "—" },
+              { key: "d", header: T.audit.summary, cell: (r) => r.summary },
+              { key: "h", header: T.audit.hash, cell: (r) => <code className="text-xs">{r.hash.slice(0, 12)}</code> },
+            ]} />
+        </Card>
+      )}
+      {next !== undefined && <div className="flex justify-center"><button type="button" disabled={load.busy} onClick={() => void search(next)} className={buttonClass.secondary}>{load.busy ? T.reason.working : "Show more"}</button></div>}
+    </div>
+  );
+}
diff --git a/src/desk/modules/lmm-top/LeadsCrm.tsx b/src/desk/modules/lmm-top/LeadsCrm.tsx
new file mode 100644
index 0000000..5a5e17f
--- /dev/null
+++ b/src/desk/modules/lmm-top/LeadsCrm.tsx
@@ -0,0 +1,120 @@
+import { useEffect, useRef, useState } from "react";
+import { Badge, Card, DataTable, EmptyState, FormField, Modal, buttonClass, cn, inputClass } from "../../ui";
+import type { LeadRow, LeadStage, TopLeadGetOut } from "../../api/lmmxContract.ts";
+import { LEAD_STAGES, eatDate, kes } from "../../api/lmmxContract.ts";
+import { errorText, lmmx } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { Spinner } from "../lmm/parts";
+import { useDebounced, useGuard, useLoad } from "../lmm/hooks.ts";
+import { LIST_LIMIT, SEARCH_DEBOUNCE_MS, fmtWhen, listKey, mergeRows, searchTerm } from "../lmm/logic.ts";
+import { S } from "../lmm/strings.ts";
+import { useTopGuard } from "./TopContext";
+import { LEAD_TABS, followUpToMs } from "./logic.ts";
+import { T } from "./strings.ts";
+
+export default function LeadsCrm() {
+  const guarded = useTopGuard();
+  const [tab, setTab] = useState<LeadStage | "all">("all");
+  const [text, setText] = useState("");
+  const q = searchTerm(useDebounced(text, SEARCH_DEBOUNCE_MS));
+  const stage = tab === "all" ? undefined : tab;
+  const key = listKey(q, stage as never);
+  const [rows, setRows] = useState<LeadRow[]>([]);
+  const [next, setNext] = useState<string | undefined>();
+  const [loading, setLoading] = useState(true);
+  const [more, setMore] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [openId, setOpenId] = useState<string | null>(null);
+  const seq = useRef(0);
+
+  async function fetchPage(cursor: string | undefined) {
+    const mine = ++seq.current;
+    if (cursor) setMore(true); else { setLoading(true); setRows([]); setNext(undefined); }
+    setError(null);
+    try {
+      const out = await guarded(() => lmmx.top.leadsList({ ...(q ? { q } : {}), ...(stage ? { stage } : {}), ...(cursor ? { cursor } : {}), limit: LIST_LIMIT }));
+      if (mine !== seq.current) return;
+      setRows((cur) => (cursor ? mergeRows(cur, out.leads, (r) => r.leadId) : out.leads)); setNext(out.nextCursor);
+    } catch (e) { if (mine === seq.current) setError(errorText(e)); }
+    finally { if (mine === seq.current) { setLoading(false); setMore(false); } }
+  }
+  // eslint-disable-next-line react-hooks/exhaustive-deps
+  useEffect(() => { void fetchPage(undefined); return () => { seq.current++; }; }, [key]);
+
+  return (
+    <div className="min-w-0 space-y-4">
+      <Card title={T.leads.title}>
+        <div className="min-w-0 space-y-3">
+          <input type="search" aria-label={T.leads.search} placeholder={T.leads.search} value={text} onChange={(e) => setText(e.target.value.slice(0, 40))} className={inputClass} />
+          <div className="flex min-w-0 flex-wrap gap-2" role="tablist" aria-label="Lead stages">
+            {LEAD_TABS.map((t) => (
+              <button key={t.id} type="button" role="tab" aria-selected={tab === t.id} onClick={() => setTab(t.id)}
+                className={cn("inline-flex h-10 items-center rounded-full px-4 text-sm font-medium", tab === t.id ? "bg-blue-600 text-white" : "border border-gray-300 bg-white text-gray-700 hover:bg-gray-50")}>{t.label}</button>
+            ))}
+          </div>
+        </div>
+      </Card>
+      {error && <Notice tone="error">{error} <button type="button" className="font-semibold underline" onClick={() => void fetchPage(undefined)}>{S.common.retry}</button></Notice>}
+      {loading ? <Spinner /> : (
+        <DataTable<LeadRow> rows={rows} rowKey={(r) => r.leadId} empty={<EmptyState title={T.leads.empty} />}
+          columns={[
+            { key: "l", header: T.leads.landlord, primary: true, cell: (r) => <button type="button" className="text-left text-blue-700 underline" onClick={() => setOpenId(r.leadId)}>{r.landlordLabel}</button> },
+            { key: "s", header: T.leads.stage, cell: (r) => <Badge tone="blue">{S.stage[r.stage]}</Badge> },
+            { key: "t", header: T.leads.tenants, align: "right", cell: (r) => r.tenants },
+            { key: "r", header: T.leads.rent, align: "right", cell: (r) => kes(r.monthlyRentMinor) },
+            { key: "d", header: T.leads.desks, cell: (r) => r.deskCodes.join(", ") },
+            { key: "f", header: T.leads.followUp, cell: (r) => (r.nextFollowUpAt ? fmtWhen(r.nextFollowUpAt) : "—") },
+            { key: "p", header: T.leads.pms, cell: (r) => <Badge tone={r.onPms ? "green" : "gray"}>{r.onPms ? S.pipeline.yes : S.pipeline.no}</Badge> },
+          ]} />
+      )}
+      {next && !loading && <div className="flex justify-center"><button type="button" disabled={more} onClick={() => void fetchPage(next)} className={buttonClass.secondary}>{more ? S.common.loading : S.common.more}</button></div>}
+      {openId && <LeadModal leadId={openId} onClose={() => setOpenId(null)} onSaved={() => void fetchPage(undefined)} />}
+    </div>
+  );
+}
+
+/** One lead with the contact details (top desk only) and the CRM fields: stage, a note, a follow-up date. */
+function LeadModal({ leadId, onClose, onSaved }: { leadId: string; onClose: () => void; onSaved: () => void }) {
+  const guarded = useTopGuard();
+  const { data, error, loading, reload } = useLoad<TopLeadGetOut>(() => guarded(() => lmmx.top.leadGet(leadId)), [leadId]);
+  const [stage, setStage] = useState<LeadStage | "">("");
+  const [note, setNote] = useState("");
+  const [date, setDate] = useState<string | null>(null);
+  const [msg, setMsg] = useState<{ tone: "ok" | "error"; text: string } | null>(null);
+  const g = useGuard();
+  const curDate = date ?? (data?.nextFollowUpAt ? eatDate(data.nextFollowUpAt) : "");
+
+  async function save() {
+    if (!data) return;
+    const fu = date === null ? undefined : followUpToMs(date);
+    const stageChanged = stage && stage !== data.stage;
+    if (!stageChanged && !note.trim() && date === null) { setMsg({ tone: "error", text: T.leads.nothing }); return; }
+    setMsg(null);
+    await g.run(async () => {
+      try {
+        // Lead notes and stages are CRM work, and the contract's leadUpdate carries no reason field (see the report: CCR-2).
+        await guarded(() => lmmx.top.leadUpdate({ leadId, ...(stageChanged ? { stage: stage as LeadStage } : {}), ...(note.trim() ? { note: note.trim().slice(0, 500) } : {}), ...(date !== null && fu !== undefined ? { nextFollowUpAt: fu } : {}) }));
+        setNote(""); setDate(null); setStage(""); setMsg({ tone: "ok", text: T.leads.saved }); reload(); onSaved();
+      } catch (e) { setMsg({ tone: "error", text: errorText(e) }); }
+    });
+  }
+  return (
+    <Modal open title={data?.landlordLabel ?? T.leads.title} onClose={onClose}
+      footer={<><button type="button" className={buttonClass.secondary} onClick={onClose}>{S.common.close}</button><button type="button" disabled={g.busy || !data} className={buttonClass.primary} onClick={() => void save()}>{g.busy ? T.leads.saving : T.leads.save}</button></>}>
+      {loading && !data ? <Spinner /> : error || !data ? <Notice tone="error">{error ?? S.common.none}</Notice> : (
+        <div className="min-w-0 space-y-4">
+          <div><h3 className="text-sm font-semibold text-gray-800">{T.leads.contact}</h3>
+            <p className="break-words text-sm">{T.leads.name}: {data.contactName}</p><p className="break-words text-sm">{T.leads.phone}: {data.contactPhone}</p></div>
+          <FormField label={T.leads.stage} htmlFor="ld-stage"><select id="ld-stage" value={stage || data.stage} onChange={(e) => setStage(e.target.value as LeadStage)} className={inputClass}>{LEAD_STAGES.map((s) => <option key={s} value={s}>{S.stage[s]}</option>)}</select></FormField>
+          <FormField label={T.leads.followUpDate} htmlFor="ld-date">
+            <div className="flex min-w-0 gap-2"><input id="ld-date" type="date" value={curDate} onChange={(e) => setDate(e.target.value)} className={inputClass} /><button type="button" className={buttonClass.secondary} onClick={() => setDate("")}>{T.leads.clearDate}</button></div>
+          </FormField>
+          <FormField label={T.leads.addNote} htmlFor="ld-note"><textarea id="ld-note" rows={3} maxLength={500} value={note} onChange={(e) => setNote(e.target.value)} className={`${inputClass} h-auto py-2`} /></FormField>
+          <div><h3 className="text-sm font-semibold text-gray-800">{T.leads.notes}</h3>
+            {data.notes.length === 0 ? <p className="text-sm text-gray-500">{T.leads.noNotes}</p> : <ul className="space-y-2">{[...data.notes].reverse().map((n) => <li key={n.ts} className="break-words rounded-xl bg-gray-50 p-2 text-sm"><span className="block text-xs text-gray-500">{fmtWhen(n.ts)} · {n.by}</span>{n.text}</li>)}</ul>}</div>
+          {msg && <Notice tone={msg.tone}>{msg.text}</Notice>}
+        </div>
+      )}
+    </Modal>
+  );
+}
diff --git a/src/desk/modules/lmm-top/ReasonModal.tsx b/src/desk/modules/lmm-top/ReasonModal.tsx
new file mode 100644
index 0000000..d637dbf
--- /dev/null
+++ b/src/desk/modules/lmm-top/ReasonModal.tsx
@@ -0,0 +1,56 @@
+import { useState } from "react";
+import type { ReactNode } from "react";
+import { FormField, Modal, buttonClass, inputClass } from "../../ui";
+import { errorText } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { useGuard } from "../lmm/hooks.ts";
+import { useTopGuard } from "./TopContext";
+import { validateTopReason } from "./logic.ts";
+import { T } from "./strings.ts";
+
+/**
+ * Every top-desk change asks for a written reason (at least 10 characters) here. `onConfirm` gets the cleaned reason and does the call;
+ * the call runs through the re-login guard (retry once). `check` can veto first (extra fields). Nothing is optimistic: the dialog stays
+ * open, with the server's words, until the server says yes.
+ */
+export default function ReasonModal({ open, title, confirmLabel, danger, onClose, onConfirm, check, children }: {
+  open: boolean; title: string; confirmLabel?: string; danger?: boolean; onClose: () => void;
+  onConfirm: (reason: string) => Promise<void>;
+  /** Return an error text to stop before sending, or null to go on. */
+  check?: () => string | null;
+  children?: ReactNode;
+}) {
+  const [reason, setReason] = useState("");
+  const [fieldError, setFieldError] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const guarded = useTopGuard();
+  const g = useGuard();
+
+  function close() { if (g.busy) return; setReason(""); setFieldError(null); setError(null); onClose(); }
+  async function go() {
+    setError(null);
+    const extra = check?.() ?? null;
+    if (extra) { setError(extra); return; }
+    const r = validateTopReason(reason);
+    if (!r.ok) { setFieldError(r.error); return; }
+    setFieldError(null);
+    await g.run(async () => {
+      try { await guarded(() => onConfirm(r.value)); setReason(""); onClose(); }
+      catch (e) { setError(errorText(e)); }
+    });
+  }
+
+  return (
+    <Modal open={open} title={title} onClose={close}
+      footer={<><button type="button" className={buttonClass.secondary} disabled={g.busy} onClick={close}>{T.reason.cancel}</button>
+        <button type="button" className={danger ? buttonClass.danger : buttonClass.primary} disabled={g.busy} onClick={() => void go()}>{g.busy ? T.reason.working : (confirmLabel ?? T.reason.confirm)}</button></>}>
+      <div className="min-w-0 space-y-4">
+        {children}
+        <FormField label={T.reason.label} htmlFor="top-reason" hint={T.reason.hint} error={fieldError}>
+          <textarea id="top-reason" rows={3} maxLength={500} value={reason} disabled={g.busy} onChange={(e) => { setReason(e.target.value); setFieldError(null); }} className={`${inputClass} h-auto py-2`} />
+        </FormField>
+        {error && <Notice tone="error">{error}</Notice>}
+      </div>
+    </Modal>
+  );
+}
diff --git a/src/desk/modules/lmm-top/ReviewQueue.tsx b/src/desk/modules/lmm-top/ReviewQueue.tsx
new file mode 100644
index 0000000..7513dd0
--- /dev/null
+++ b/src/desk/modules/lmm-top/ReviewQueue.tsx
@@ -0,0 +1,56 @@
+import { useState } from "react";
+import { Badge, Card, EmptyState, buttonClass } from "../../ui";
+import type { TopReviewRow } from "../../api/lmmxContract.ts";
+import { channelLabel } from "../../api/lmmxContract.ts";
+import { lmmx } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { Spinner } from "../lmm/parts";
+import { useLoad } from "../lmm/hooks.ts";
+import { fmtWhen } from "../lmm/logic.ts";
+import ReasonModal from "./ReasonModal";
+import { useTopGuard } from "./TopContext";
+import { T } from "./strings.ts";
+
+type Act = { row: TopReviewRow; kind: "approve" | "reject" | "freeze" };
+
+export default function ReviewQueue() {
+  const guarded = useTopGuard();
+  const { data, error, loading, reload } = useLoad(() => guarded(() => lmmx.top.reviewQueue()), []);
+  const [act, setAct] = useState<Act | null>(null);
+  const [done, setDone] = useState(false);
+
+  async function confirm(reason: string) {
+    if (!act) return;
+    const id = act.row.recipientId;
+    if (act.kind === "freeze") await lmmx.top.freeze({ scope: "recipient", id, reason });
+    else await lmmx.top.reviewDecision({ recipientId: id, decision: act.kind, reason });
+    setDone(true); reload();
+  }
+  const title = act?.kind === "approve" ? T.review.approveTitle : act?.kind === "reject" ? T.review.rejectTitle : T.review.freezeTitle;
+  return (
+    <div className="min-w-0 space-y-4">
+      <h2 className="text-base font-semibold text-gray-900">{T.review.title}</h2>
+      {done && <Notice tone="ok">{T.review.done}</Notice>}
+      {error && <Notice tone="error">{error} <button type="button" className="font-semibold underline" onClick={reload}>Try again</button></Notice>}
+      {loading && !data ? <Spinner /> : data && (data.items.length === 0 ? <EmptyState title={T.review.empty} /> : (
+        <ul className="min-w-0 space-y-3">
+          {data.items.map((r) => (
+            <li key={r.recipientId}><Card>
+              <div className="min-w-0 space-y-3">
+                <p className="flex flex-wrap items-center gap-2 text-sm"><Badge tone="amber">{T.review.reason[r.reason]}</Badge><span className="text-gray-500">{fmtWhen(r.createdAt)}</span></p>
+                <p className="break-words text-sm">{T.review.account}: <strong>{channelLabel(r.channel)} {r.accountNumber}</strong></p>
+                <p className="text-sm text-gray-600">{T.review.tenants}: {r.tenants} · {T.review.desks}: {r.desks}</p>
+                <div className="flex flex-wrap gap-2">
+                  <button type="button" className={buttonClass.primary} onClick={() => { setDone(false); setAct({ row: r, kind: "approve" }); }}>{T.review.approve}</button>
+                  <button type="button" className={buttonClass.danger} onClick={() => { setDone(false); setAct({ row: r, kind: "reject" }); }}>{T.review.reject}</button>
+                  <button type="button" className={buttonClass.secondary} onClick={() => { setDone(false); setAct({ row: r, kind: "freeze" }); }}>{T.review.freeze}</button>
+                </div>
+              </div>
+            </Card></li>
+          ))}
+        </ul>
+      ))}
+      <ReasonModal open={!!act} title={title} danger={act?.kind !== "approve"} onClose={() => setAct(null)} onConfirm={confirm} />
+    </div>
+  );
+}
diff --git a/src/desk/modules/lmm-top/StatsView.tsx b/src/desk/modules/lmm-top/StatsView.tsx
