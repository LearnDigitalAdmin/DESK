+import { useState } from "react";
+import { Card, DataTable, EmptyState, FormField, Stat, StatGrid, buttonClass, inputClass } from "../../ui";
+import { kes } from "../../api/lmmxContract.ts";
+import { lmmx } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { Spinner } from "./parts";
+import { useLoad } from "./hooks.ts";
+import { defaultRange, displayMasked, rangeToMs } from "./logic.ts";
+import { S } from "./strings.ts";
+
+export default function Earnings() {
+  const [range, setRange] = useState(() => defaultRange(Date.now()));
+  const [applied, setApplied] = useState(range);
+  const ms = rangeToMs(applied.from, applied.to);
+  const { data, error, loading, reload } = useLoad(() => (ms ? lmmx.earnings(ms.from, ms.to) : Promise.reject(new Error(S.earnings.badRange))), [applied.from, applied.to]);
+  const bad = rangeToMs(range.from, range.to) === null;
+  return (
+    <div className="min-w-0 space-y-4">
+      <Card>
+        <div className="grid min-w-0 gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
+          <FormField label={S.earnings.from} htmlFor="e-from"><input id="e-from" type="date" value={range.from} onChange={(e) => setRange({ ...range, from: e.target.value })} className={inputClass} /></FormField>
+          <FormField label={S.earnings.to} htmlFor="e-to"><input id="e-to" type="date" value={range.to} onChange={(e) => setRange({ ...range, to: e.target.value })} className={inputClass} /></FormField>
+          <button type="button" disabled={bad} onClick={() => setApplied(range)} className={buttonClass.primary}>{S.earnings.show}</button>
+        </div>
+        {bad && <p role="alert" className="mt-2 text-xs text-red-600">{S.earnings.badRange}</p>}
+      </Card>
+      {error && <Notice tone="error">{error} <button type="button" className="font-semibold underline" onClick={reload}>{S.common.retry}</button></Notice>}
+      {loading && !data ? <Spinner /> : data && (
+        <>
+          <StatGrid>
+            <Stat label={S.earnings.instalments} value={data.instalments} />
+            <Stat label={S.earnings.share} value={kes(data.deskShareMinor)} tone="good" />
+            <Stat label={S.earnings.completion} value={kes(data.completionBonusMinor)} />
+            <Stat label={S.earnings.landlordBonus} value={kes(data.landlordBonusMinor)} />
+          </StatGrid>
+          <Card title={S.earnings.byTenant}>
+            <DataTable rows={data.byTenant} rowKey={(r) => r.tenantId} empty={<EmptyState title={S.earnings.empty} />}
+              columns={[{ key: "n", header: S.wizard.fullName, primary: true, cell: (r) => displayMasked(r.nameMasked) }, { key: "d", header: S.earnings.share, align: "right", cell: (r) => kes(r.deskShareMinor) }]} />
+          </Card>
+        </>
+      )}
+    </div>
+  );
+}
diff --git a/src/desk/modules/lmm/LmmScreen.tsx b/src/desk/modules/lmm/LmmScreen.tsx
new file mode 100644
index 0000000..308d19d
--- /dev/null
+++ b/src/desk/modules/lmm/LmmScreen.tsx
@@ -0,0 +1,54 @@
+import { NavLink, Navigate, Route, Routes, useParams } from "react-router-dom";
+import { EmptyState, Page, cn } from "../../ui";
+import { useAgent } from "../../core/useAgent";
+import AddTenantWizard from "./AddTenantWizard";
+import Earnings from "./Earnings";
+import Pipeline from "./Pipeline";
+import TenantDetail from "./TenantDetail";
+import TenantsList from "./TenantsList";
+import WaitingScreen from "./WaitingScreen";
+import { LMM_BASE } from "./logic.ts";
+import { Spinner } from "./parts";
+import { S } from "./strings.ts";
+
+const tab = ({ isActive }: { isActive: boolean }) =>
+  cn("inline-flex h-11 items-center rounded-xl px-4 text-sm font-semibold", isActive ? "bg-blue-600 text-white" : "border border-gray-300 bg-white text-gray-700 hover:bg-gray-50");
+
+function Detail() {
+  const { tenantId = "" } = useParams();
+  return <TenantDetail tenantId={tenantId} backTo={LMM_BASE} backLabel={S.nav.tenants} />;
+}
+
+function Home() {
+  return (
+    <Page title={S.brand} subtitle={S.moduleDescription}>
+      <nav aria-label={S.brand} className="flex min-w-0 flex-wrap gap-2">
+        <NavLink to={LMM_BASE} end className={tab}>{S.nav.tenants}</NavLink>
+        <NavLink to={`${LMM_BASE}/new`} className={tab}>{S.nav.add}</NavLink>
+        <NavLink to={`${LMM_BASE}/earnings`} className={tab}>{S.nav.earnings}</NavLink>
+        <NavLink to={`${LMM_BASE}/pipeline`} className={tab}>{S.nav.pipeline}</NavLink>
+      </nav>
+      <Routes>
+        <Route index element={<TenantsList detailBase={LMM_BASE} />} />
+        <Route path="new" element={<AddTenantWizard />} />
+        <Route path="earnings" element={<Earnings />} />
+        <Route path="pipeline" element={<Pipeline />} />
+        <Route path="*" element={<Navigate to={LMM_BASE} replace />} />
+      </Routes>
+    </Page>
+  );
+}
+
+/** The desk agent's Lipa Mdogo Mdogo area. The server decides what each person may see; this only lays the screens out. */
+export default function LmmScreen() {
+  const agent = useAgent();
+  if (agent === undefined) return <Spinner />;
+  if (agent === null) return <Page title={S.brand}><EmptyState title={S.denied.title} body={S.denied.body} /></Page>;
+  return (
+    <Routes>
+      <Route path="tenant/:tenantId" element={<Detail />} />
+      <Route path="waiting/:tenantId" element={<WaitingScreen />} />
+      <Route path="*" element={<Home />} />
+    </Routes>
+  );
+}
diff --git a/src/desk/modules/lmm/OtpPanel.tsx b/src/desk/modules/lmm/OtpPanel.tsx
new file mode 100644
index 0000000..84cf40d
--- /dev/null
+++ b/src/desk/modules/lmm/OtpPanel.tsx
@@ -0,0 +1,94 @@
+import { useState } from "react";
+import { AlertTriangle, CheckCircle2, Clock, Lock } from "lucide-react";
+import { Card, FormField, buttonClass, inputClass } from "../../ui";
+import { errorText } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { useGuard, useNow } from "./hooks.ts";
+import { fmtCountdown, normaliseOtp, sanitizeOtpInput, secondsLeft } from "./logic.ts";
+import type { OtpView } from "./logic.ts";
+import { S } from "./strings.ts";
+
+/**
+ * The "Waiting for verification" box, shared by setup and by changes. It only SHOWS state it is given (`view`): the parent polls the
+ * server. Typing the code never changes the screen by itself (no optimistic updates): after a try, `onSubmit` must refresh `view`.
+ */
+export default function OtpPanel({ view, title, subtitle, onSubmit, onResend, extra, refreshing }: {
+  view: OtpView;
+  title?: string;
+  subtitle?: string;
+  /** Throws with the server's message on a wrong code; the panel shows it. */
+  onSubmit: (otp: string) => Promise<void>;
+  /** Omit for changes (a change has no resend). */
+  onResend?: () => Promise<void>;
+  extra?: React.ReactNode;
+  refreshing?: boolean;
+}) {
+  const now = useNow(view.phase === "waiting");
+  const [text, setText] = useState("");
+  const [fieldError, setFieldError] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const submit = useGuard();
+  const resend = useGuard();
+
+  if (view.phase === "done") return <Notice tone="ok"><span className="inline-flex items-center gap-2"><CheckCircle2 size={18} />{S.waiting.doneTitle}</span></Notice>;
+
+  const left = secondsLeft(view.expiresAt, now);
+
+  async function send(e: React.FormEvent) {
+    e.preventDefault();
+    setError(null);
+    const p = normaliseOtp(text);
+    if (!p.ok) { setFieldError(S.waiting.badCode); return; }
+    setFieldError(null);
+    await submit.run(async () => {
+      try { await onSubmit(p.otp); setText(""); } catch (err) { setError(errorText(err)); }
+    });
+  }
+  async function again() {
+    if (!onResend) return;
+    setError(null);
+    await resend.run(async () => { try { await onResend(); setText(""); } catch (err) { setError(errorText(err)); } });
+  }
+
+  const resendBlock = onResend && (view.phase === "waiting" || view.phase === "expired") && (
+    <div className="space-y-1">
+      <button type="button" disabled={!view.canResend || resend.busy} onClick={() => void again()} className={buttonClass.secondary}>{resend.busy ? S.waiting.resending : S.waiting.resend}</button>
+      {view.resendsLeft !== undefined && <p className="text-xs text-gray-500">{view.canResend ? S.waiting.resendsLeft(view.resendsLeft) : S.waiting.noResends}</p>}
+    </div>
+  );
+
+  return (
+    <Card title={title ?? S.waiting.title}>
+      <div className="min-w-0 space-y-4">
+        {view.phase === "waiting" && (
+          <>
+            <p className="break-words text-sm text-gray-700">{subtitle ?? S.waiting.sub}</p>
+            {view.expiresAt !== undefined && <p className="inline-flex items-center gap-2 text-sm font-semibold text-gray-900"><Clock size={18} aria-hidden />{S.waiting.left}: <span className="tabular-nums" aria-live="off">{fmtCountdown(left)}</span></p>}
+            <form onSubmit={(e) => void send(e)} className="min-w-0 space-y-3">
+              <FormField label={S.waiting.codeLabel} htmlFor="lmm-otp" hint={S.waiting.codeHint} error={fieldError}>
+                <input id="lmm-otp" inputMode="text" autoComplete="one-time-code" autoCapitalize="characters" maxLength={8} value={text} disabled={submit.busy}
+                  onChange={(e) => { setText(sanitizeOtpInput(e.target.value)); setFieldError(null); }} className={`${inputClass} text-center text-xl font-semibold tracking-widest`} placeholder="LMM4683" />
+              </FormField>
+              <button type="submit" disabled={!view.canSubmit || submit.busy} className={buttonClass.primary}>{submit.busy ? S.waiting.confirming : S.waiting.confirm}</button>
+              {view.attemptsLeft !== undefined && <p className="text-xs text-gray-500">{S.waiting.attempts(view.attemptsLeft)}</p>}
+            </form>
+            <p className="break-words text-sm text-gray-600">{S.waiting.whatsapp}</p>
+            {refreshing && <p className="text-xs text-gray-400" role="status">{S.waiting.refreshing}</p>}
+          </>
+        )}
+        {view.phase === "expired" && (
+          <div className="space-y-3"><p className="flex items-center gap-2 text-sm font-semibold text-amber-800"><AlertTriangle size={18} aria-hidden />{S.waiting.expiredTitle}</p><p className="text-sm text-gray-700">{S.waiting.expiredBody}</p></div>
+        )}
+        {view.phase === "locked" && (
+          <div className="space-y-2"><p className="flex items-center gap-2 text-sm font-semibold text-red-800"><Lock size={18} aria-hidden />{S.waiting.lockedTitle}</p><p className="text-sm text-gray-700">{S.waiting.lockedBody}</p></div>
+        )}
+        {view.phase === "review" && <Notice tone="info"><strong>{S.waiting.reviewTitle}.</strong> {S.waiting.reviewBody}</Notice>}
+        {view.phase === "closed" && <Notice tone="error"><strong>{S.waiting.closedTitle}.</strong> {S.waiting.closedBody}</Notice>}
+        {view.phase === "blocked" && <Notice tone="info"><strong>{S.waiting.blockedTitle}.</strong> {S.waiting.blockedBody}</Notice>}
+        {resendBlock}
+        {error && <Notice tone="error">{error}</Notice>}
+        {extra}
+      </div>
+    </Card>
+  );
+}
diff --git a/src/desk/modules/lmm/Pipeline.tsx b/src/desk/modules/lmm/Pipeline.tsx
new file mode 100644
index 0000000..5b3357d
--- /dev/null
+++ b/src/desk/modules/lmm/Pipeline.tsx
@@ -0,0 +1,52 @@
+import { useEffect, useRef, useState } from "react";
+import { Badge, Card, DataTable, EmptyState, buttonClass } from "../../ui";
+import type { PipelineRow } from "../../api/lmmxContract.ts";
+import { kes } from "../../api/lmmxContract.ts";
+import { errorText, lmmx } from "../../api/lmmx.ts";
+import Notice from "../top/Notice";
+import { Spinner } from "./parts";
+import { mergeRows } from "./logic.ts";
+import { S } from "./strings.ts";
+
+/** Read-only: the landlords tied to this desk's tenants. All text (including what a conversion pays) comes from the server. */
+export default function Pipeline() {
+  const [rows, setRows] = useState<PipelineRow[]>([]);
+  const [next, setNext] = useState<string | undefined>();
+  const [loading, setLoading] = useState(true);
+  const [more, setMore] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const seq = useRef(0);
+  async function load(cursor?: string) {
+    const mine = ++seq.current;
+    if (cursor) setMore(true); else setLoading(true);
+    setError(null);
+    try {
+      const out = await lmmx.pipeline(cursor);
+      if (mine !== seq.current) return;
+      setRows((cur) => (cursor ? mergeRows(cur, out.landlords, (r) => r.leadIdMasked) : out.landlords)); setNext(out.nextCursor);
+    } catch (e) { if (mine === seq.current) setError(errorText(e)); }
+    finally { if (mine === seq.current) { setLoading(false); setMore(false); } }
+  }
+  // eslint-disable-next-line react-hooks/exhaustive-deps
+  useEffect(() => { void load(); return () => { seq.current++; }; }, []);
+  return (
+    <div className="min-w-0 space-y-4">
+      <p className="break-words text-sm text-gray-600">{S.pipeline.sub}</p>
+      {error && <Notice tone="error">{error} <button type="button" className="font-semibold underline" onClick={() => void load()}>{S.common.retry}</button></Notice>}
+      {loading ? <Spinner /> : (
+        <Card>
+          <DataTable<PipelineRow> rows={rows} rowKey={(r) => r.leadIdMasked} empty={<EmptyState title={S.pipeline.empty} />}
+            columns={[
+              { key: "l", header: "Landlord", primary: true, cell: (r) => r.landlordLabel },
+              { key: "t", header: S.pipeline.tenants, align: "right", cell: (r) => r.tenants },
+              { key: "r", header: S.pipeline.rent, align: "right", cell: (r) => kes(r.monthlyRentMinor) },
+              { key: "s", header: S.pipeline.stage, cell: (r) => <Badge tone="blue">{S.stage[r.stage]}</Badge> },
+              { key: "p", header: S.pipeline.onPms, cell: (r) => <Badge tone={r.onPms ? "green" : "gray"}>{r.onPms ? S.pipeline.yes : S.pipeline.no}</Badge> },
+              { key: "n", header: "What happens next", cell: (r) => r.conversionNote },
+            ]} />
+        </Card>
+      )}
+      {next && !loading && <div className="flex justify-center"><button type="button" disabled={more} onClick={() => void load(next)} className={buttonClass.secondary}>{more ? S.common.loading : S.common.more}</button></div>}
+    </div>
+  );
+}
diff --git a/src/desk/modules/lmm/RecipientFields.tsx b/src/desk/modules/lmm/RecipientFields.tsx
new file mode 100644
index 0000000..e12eda7
--- /dev/null
+++ b/src/desk/modules/lmm/RecipientFields.tsx
@@ -0,0 +1,72 @@
+import { useEffect, useState } from "react";
+import { FormField, buttonClass, inputClass } from "../../ui";
+import { CHANNELS } from "../../api/lmmxContract.ts";
+import type { Channel } from "../../api/lmmxContract.ts";
+import { listBanks } from "../../api/lmmx.ts";
+import type { Bank } from "../../api/lmmx.ts";
+import { sanitizePhoneInput } from "../../access/phone.ts";
+import Notice from "../top/Notice";
+import type { Dedupe } from "./useRecipientCheck.ts";
+import type { Errors, RecipientForm } from "./logic.ts";
+import { S } from "./strings.ts";
+
+/** The landlord payment fields (channel, bank, account, registered name, contact). Used by the wizard, the change form and the top-desk update. */
+export function RecipientFields({ value, onChange, errors, disabled }: { value: RecipientForm; onChange: (v: RecipientForm) => void; errors: Errors<RecipientForm>; disabled?: boolean }) {
+  const [banks, setBanks] = useState<Bank[] | null>(null);
+  const [bankError, setBankError] = useState<string | null>(null);
+  const [tries, setTries] = useState(0);
+  useEffect(() => {
+    if (value.channel !== "bank" || banks) return;
+    let alive = true;
+    listBanks().then((b) => { if (alive) { setBanks(b); setBankError(null); } }, () => { if (alive) setBankError(S.wizard.banksFailed); });
+    return () => { alive = false; };
+  }, [value.channel, banks, tries]);
+  const set = (p: Partial<RecipientForm>) => onChange({ ...value, ...p });
+  const accountLabel = value.channel === "phone" ? S.wizard.accountPhone : value.channel === "till" ? S.wizard.accountTill : S.wizard.accountBank;
+  return (
+    <div className="min-w-0 space-y-4">
+      <FormField label={S.wizard.channel} htmlFor="rf-channel">
+        <select id="rf-channel" value={value.channel} disabled={disabled} onChange={(e) => set({ channel: e.target.value as Channel, bankCode: "", accountNumber: "" })} className={inputClass}>
+          {CHANNELS.map((c) => <option key={c} value={c}>{S.channel[c]}</option>)}
+        </select>
+      </FormField>
+      {value.channel === "bank" && (
+        <FormField label={S.wizard.bank} htmlFor="rf-bank" error={errors.bankCode ?? bankError}>
+          <select id="rf-bank" value={value.bankCode} disabled={disabled || !banks} onChange={(e) => set({ bankCode: e.target.value })} className={inputClass}>
+            <option value="">{banks ? S.wizard.bankPick : S.wizard.banksLoading}</option>
+            {banks?.map((b) => <option key={b.code} value={b.code}>{b.name}</option>)}
+          </select>
+          {bankError && <button type="button" className={`${buttonClass.secondary} mt-2`} onClick={() => setTries((n) => n + 1)}>{S.common.retry}</button>}
+        </FormField>
+      )}
+      <FormField label={accountLabel} htmlFor="rf-account" error={errors.accountNumber}>
+        <input id="rf-account" inputMode={value.channel === "bank" ? "text" : "numeric"} autoComplete="off" value={value.accountNumber} disabled={disabled}
+          onChange={(e) => set({ accountNumber: value.channel === "phone" ? sanitizePhoneInput(e.target.value) : e.target.value.slice(0, 30) })} className={inputClass} />
+      </FormField>
+      <FormField label={S.wizard.accountName} htmlFor="rf-name" hint={S.wizard.accountNameHint} error={errors.accountName}>
+        <input id="rf-name" autoComplete="off" value={value.accountName} disabled={disabled} onChange={(e) => set({ accountName: e.target.value.slice(0, 80) })} className={inputClass} />
+      </FormField>
+      <FormField label={S.wizard.contactName} htmlFor="rf-cname" error={errors.contactName}>
+        <input id="rf-cname" autoComplete="off" value={value.contactName} disabled={disabled} onChange={(e) => set({ contactName: e.target.value.slice(0, 80) })} className={inputClass} />
+      </FormField>
+      <FormField label={S.wizard.contactPhone} htmlFor="rf-cphone" hint={S.wizard.contactHint} error={errors.contactPhone}>
+        <input id="rf-cphone" type="tel" inputMode="tel" autoComplete="off" value={value.contactPhone} disabled={disabled} onChange={(e) => set({ contactPhone: sanitizePhoneInput(e.target.value) })} className={inputClass} />
+      </FormField>
+    </div>
+  );
+}
+
+export function DedupePrompt({ dedupe, onAnswer }: { dedupe: Dedupe; onAnswer: (same: boolean) => void }) {
+  if (dedupe.state !== "ask") return null;
+  return (
+    <Notice tone="info">
+      <span className="block font-semibold">{S.wizard.dedupeTitle}</span>
+      <span className="mt-1 block">{S.wizard.dedupeAccount}: <strong className="break-all">{dedupe.accountNumber}</strong></span>
+      <span className="mt-2 block">{S.wizard.dedupeAsk}</span>
+      <span className="mt-3 flex flex-wrap gap-2">
+        <button type="button" className={buttonClass.primary} onClick={() => onAnswer(true)}>{S.wizard.dedupeYes}</button>
+        <button type="button" className={buttonClass.secondary} onClick={() => onAnswer(false)}>{S.wizard.dedupeNo}</button>
+      </span>
+    </Notice>
+  );
+}
